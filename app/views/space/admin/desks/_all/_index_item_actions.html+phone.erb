<div id="tr_<%= model.id %>" class="card as-narrow">
  <div class="card-content">
    <%= yield %>
  </div>
  <div class="card-footer">
    <%=
      link_to(
        { controller: 'trade/admin/desk/orders', desk_id: model.id },
        class: "card-footer-item #{model.counters['undo'].to_i > 0 ? 'is-danger' : 'is-warning'}"
      ) do
    %>
      <span><%= model.counters['undo'].to_i %>订单</span>
    <% end %>
    <%= link_to({ controller: 'factory/agent/productions', desk_id: model.id, dispatch: 'dine' }, class: 'card-footer-item') do %>
      <span>点餐</span>
    <% end %>
    <%= button_to({ action: 'actions', id: model.id, station_id: model.room.station_id, room_id: model.room_id }, form: { class: 'card-footer-item' }) do %>
      <%= svg_tag 'ellipsis-vertical' %>
      <span><%= t('.actions.title') %></span>
    <% end %>
  </div>
</div>
