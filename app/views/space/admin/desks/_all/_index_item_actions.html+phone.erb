<div id="tr_<%= model.id %>" class="media as-boxed">
  <div class="media-content">
    <%= yield %>
  </div>
  <div class="media-right as-centered">
    <%=
      link_to(
        { controller: 'trade/admin/desk/orders', desk_id: model.id },
        class: "button #{model.counters['unreceived_amount'].to_d > 0 ? 'is-danger' : 'is-warning'} flex-direction-column"
      ) do
    %>
      <p>
        <span>待结算：</span>
        <span><%= model.counters['unreceived_amount'].to_money.format.html_safe %></span>
      </p>
    <% end %>
    <%= link_to({ controller: 'factory/agent/productions', desk_id: model.id, dispatch: 'dine' }, class: 'button is-success') do %>
      <span>点餐</span>
    <% end %>
    <%= button_to({ action: 'actions', id: model.id, station_id: model.room.station_id, room_id: model.room_id }, class: 'button is-primary') do %>
      <%= svg_tag 'ellipsis-vertical' %>
      <span><%= t('.actions.title') %></span>
    <% end %>
  </div>
</div>
