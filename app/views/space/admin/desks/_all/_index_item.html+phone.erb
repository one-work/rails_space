<p>
  <strong><%= model.name %></strong>
  <% if model.code.present? %>
    <span class="tag"><%= model.code %></span>
  <% end %>
  <% if model.people.present? %>
    <span class="tag"><%= model.people %>人</span>
  <% end %>
</p>
<p>
  <span>待结算金额：</span>
  <span><%= model.counters['unreceived_amount'].to_money.format.html_safe %></span>
</p>
