<%= button_to({ action: 'destroy' }, method: :delete, class: 'cell has-column-centered', form: { data: { turbo_confirm: t('.destroy.confirm') } }) do %>
  <%= svg_tag 'trash' %>
  <span><%= t('.destroy.title') %></span>
<% end %>
<%= button_to({ action: 'edit' }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'pencil' %>
  <span><%= t('.edit.title') %></span>
<% end %>
<%= link_to({ action: 'show' }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'eye' %>
  <span><%= t('.show.title') %></span>
<% end %>
<%= link_to({ controller: 'desks', room_id: model.id }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'couch' %>
  <span><%= t('space.admin.desks.index.title') %></span>
<% end %>
<%=
  button_to(
    { controller: 'print/admin/home', action: 'inner' },
    params: { gid: model.to_gid.to_s, aim: 'label' },
    id: 'print-button',
    data: { controller: 'print-pos' },
    class: 'cell has-column-centered'
  ) do
%>
  <%= svg_tag 'print' %>
  <span><%= t('print.admin.home.inner.title') %></span>
<% end %>
