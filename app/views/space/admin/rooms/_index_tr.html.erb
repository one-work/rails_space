<%=
  tr_tag(
    model,
    {
      href: url_for(controller: 'grids', room_id: model.id),
      icon: 'grip-lines',
      title: t('.grids.index.title')
    },
    {
      href: url_for(controller: 'desks', room_id: model.id),
      icon: 'couch',
      title: t('.desks.index.title')
    }
  ) { yield }
%>
