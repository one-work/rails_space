<%= button_to({ action: 'edit', id: model.id }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'pencil' %>
  <span><%= t('.edit.title') %></span>
<% end %>
<%= button_to({ action: 'destroy', id: model.id }, method: :delete, form: { turbo_confirm: t('.destroy.confirm') }, class: 'cell has-column-centered') do %>
  <%= svg_tag 'trash' %>
  <span><%= t('.destroy.title') %></span>
<% end %>
<%=
  button_to(
    { controller: 'print/admin/home', action: 'inner' },
    params: { gid: model.to_gid.to_s, aim: 'label' },
    id: 'print-button',
    data: { controller: 'print-pos' },
    class: 'cell has-column-centered'
  ) do
%>
  <%= svg_tag 'print' %>
  <span><%= t('print.admin.home.inner.title') %></span>
<% end %>
