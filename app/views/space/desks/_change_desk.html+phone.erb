<% if model.id.to_s == params[:desk_id] %>
  <div class="cell has-column-centered">
    <strong><%= model.name %></strong>
    <span class="text-grey"><%= model.code %></span>
  </div>
<% else %>
  <%=
    link_to(
      { controller: params.fetch(:con, '/factory/productions'), desk_id: model.id },
      data: { turbo_action: 'replace' },
      class: 'cell has-column-centered'
    ) do
  %>
    <strong><%= model.name %></strong>
    <span class="text-grey"><%= model.code %></span>
  <% end %>
<% end %>
