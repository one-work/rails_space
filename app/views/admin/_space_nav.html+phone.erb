<div class="card as-transparent">
  <div class="card-header">
    <span class="size-7 text-grey has-border-left-primary"><%= t('space.admin.title') %></span>
  </div>
  <div class="card-content fixed-grid has-4-cols">
    <div class="grid">
      <%= link_to({ controller: 'space/admin/stations' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'building', class: 'icon is-medium text-primary' %>
        <div class="text-grey size-7 mt-1"><%= t('space.admin.stations.index.title') %></div>
      <% end %>
      <%= link_to({ controller: 'space/admin/desks', action: 'all' }, class: 'cell has-column-centered') do %>
        <%= svg_tag 'chair', class: 'icon is-medium text-primary' %>
        <div class="text-grey size-7 mt-1"><%= t('space.admin.desks.all.title') %></div>
      <% end %>
    </div>
  </div>
</div>
