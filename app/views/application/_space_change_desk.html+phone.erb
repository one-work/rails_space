<% if model.id.to_s == params[:desk_id] %>
  <div class="cell has-column-centered button is-primary">
    <strong class="is-wrap"><%= model.name %></strong>
    <% if model.people %>
      <span class="size-7"><%= model.people %>人</span>
    <% end %>
  </div>
<% else %>
  <%=
    link_to(
      { controller: defined?(con) ? con : '/factory/productions', desk_id: model.id },
      data: { turbo_action: 'replace' },
      class: 'cell has-column-centered button is-outlined is-primary'
    ) do
  %>
    <strong class="is-wrap"><%= model.name %></strong>
    <% if model.people %>
      <span class="size-7 text-grey"><%= model.people %>人</span>
    <% end %>
  <% end %>
<% end %>
